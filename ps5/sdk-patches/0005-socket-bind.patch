 X_STATUS XSocket::Bind(N_XSOCKADDR_IN* name, int name_len) {
+#if REX_PLATFORM_MAC || REX_PLATFORM_PS5
+  // BSD sockaddrs start with sin_len; N_XSOCKADDR_IN's 16-bit family does not
+  // match that layout, so build the native address explicitly.
+  sockaddr_in native = {};
+  native.sin_len = sizeof(native);
+  native.sin_family = AF_INET;
+  std::memcpy(&native.sin_port, &name->sin_port, sizeof(native.sin_port));
+  std::memcpy(&native.sin_addr, &name->sin_addr, sizeof(native.sin_addr));
+  int ret = bind(native_handle_, reinterpret_cast<sockaddr*>(&native), sizeof(native));
+#if REX_PLATFORM_PS5
+  // Titles are not root, and FreeBSD reserves ports below 1024. Xbox titles
+  // bind there freely (Table Tennis uses VDP port 1001), so fall back to an
+  // ephemeral port; cross-console system link is out of reach anyway.
+  if (ret < 0 && errno == EACCES && ntohs(native.sin_port) < 1024) {
+    REXSYS_WARN("bind to reserved port {} refused; using an ephemeral port",
+                ntohs(native.sin_port));
+    native.sin_port = 0;
+    ret = bind(native_handle_, reinterpret_cast<sockaddr*>(&native), sizeof(native));
+  }
+#endif
+#else
   int ret = bind(native_handle_, (sockaddr*)name, name_len);
+#endif
   if (ret < 0) {
+    REXSYS_WARN("bind to port {} failed: errno {}", uint16_t(name->sin_port), errno);
     return X_STATUS_UNSUCCESSFUL;
   }
 
