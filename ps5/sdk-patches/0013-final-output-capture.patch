+bool VulkanPresenter::CaptureFinalOutput(RawImage& image_out) {
+  std::unique_lock<std::mutex> lock(final_capture_mutex_);
+  if (final_capture_target_) {
+    return false;  // Another capture is waiting.
+  }
+  final_capture_target_ = &image_out;
+  final_capture_result_ = false;
+  final_capture_cv_.wait_for(lock, std::chrono::seconds(3),
+                             [this] { return final_capture_target_ == nullptr; });
+  final_capture_target_ = nullptr;
+  return final_capture_result_;
+}
